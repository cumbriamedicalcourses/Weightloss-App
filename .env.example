# Copy to .env.local for local development. On Hostinger, add these as
# environment variables for the Node.js app, then rebuild.

# Firebase web app settings (Firebase console > Project settings > Your apps).
# These are safe to expose in the browser. Leave empty to run in preview mode,
# where the journal is kept in the browser only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Secret. Used on the server only, for photo calorie estimates.
ANTHROPIC_API_KEY=

# Free key from https://fdc.nal.usda.gov/api-key-signup for food search.
# Without it the shared DEMO_KEY is used, which is heavily rate limited.
USDA_API_KEY=

# Optional: link for the "Get the book on Amazon" button on the homepage.
NEXT_PUBLIC_AMAZON_URL=

# Optional: photo estimates each person may request per day (default 30).
PHOTO_ESTIMATES_PER_DAY=

# Optional: contact address shown in the privacy policy and terms.
NEXT_PUBLIC_CONTACT_EMAIL=
